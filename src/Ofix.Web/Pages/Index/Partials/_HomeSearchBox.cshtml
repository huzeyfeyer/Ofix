@model Ofix.Web.Pages.Index.HomePageViewModel
@using Ofix.CarListings
@using Microsoft.AspNetCore.Mvc.Localization
@using Ofix.Localization
@inject IHtmlLocalizer<OfixResource> L

<section class="ofix-home-search-panel card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <form id="HomeSearchForm"
              method="get"
              action="/Marketplace"
              data-models-handler="/?handler=ModelsByBrand"
              data-count-handler="/?handler=SearchResultCount">

            <input type="hidden" id="HomeBodyShape" name="bodyShape" value="" />

            @if (Model.BodyShapes.Count > 0)
            {
                <div class="ofix-home-body-types mb-4">
                    <span class="form-label d-block small text-muted mb-2">@L["BodyShape"]</span>
                    <div class="ofix-home-body-types-scroll d-flex flex-nowrap gap-2 pb-1" role="group" aria-label="@L["BodyShape"]">
                        <button type="button"
                                class="ofix-body-chip active"
                                data-body-shape=""
                                aria-pressed="true">
                            @L["Marketplace:AllBodyTypes"]
                        </button>
                        @foreach (var shape in Model.BodyShapes)
                        {
                            <button type="button"
                                    class="ofix-body-chip"
                                    data-body-shape="@shape.Value"
                                    aria-pressed="false"
                                    title="@shape.Label">
                                <i class="fa fa-car ofix-body-chip-icon" aria-hidden="true"></i>
                                <span class="ofix-body-chip-label">@shape.Label</span>
                            </button>
                        }
                    </div>
                </div>

                <hr class="ofix-home-search-divider my-4" />
            }

            <div class="row g-3 align-items-end">
                <div class="col-6 col-md-3">
                    <label class="form-label" for="HomeBrandId">@L["Brand"]</label>
                    <select id="HomeBrandId" name="BrandId" class="form-select">
                        <option value="">@L["Marketplace:AllBrands"]</option>
                        @foreach (var brand in Model.AllBrands)
                        {
                            <option value="@brand.Id">@brand.Name</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="HomeModelId">@L["Model"]</label>
                    <select id="HomeModelId" name="ModelId" class="form-select" disabled>
                        <option value="">@L["Marketplace:AllModels"]</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label" for="HomeMinYear">@L["Year"]</label>
                    <input id="HomeMinYear" name="minYear" type="number" class="form-control"
                           min="@CarListingConsts.MinYear" max="@Model.MaxYear"
                           placeholder="@L["Marketplace:From"]" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label" for="HomeMaxPrice">@L["Price"]</label>
                    <input id="HomeMaxPrice" name="maxPrice" type="number" class="form-control"
                           min="@CarListingConsts.MinPrice" max="@CarListingConsts.MaxPrice"
                           placeholder="@L["Marketplace:To"]" />
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" id="HomeSearchSubmit" class="btn btn-success w-100">
                        @L["Home:SearchResults", Model.TotalListingCount]
                    </button>
                </div>
            </div>

            <div class="mt-3">
                <a href="/Marketplace" class="text-success text-decoration-none small">
                    @L["Home:AdvancedSearch"] <i class="fa fa-angle-right ms-1"></i>
                </a>
            </div>
        </form>
    </div>
</section>
