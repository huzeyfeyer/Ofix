@page
@model Ofix.Web.Pages.IndexModel
@using Ofix.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Microsoft.AspNetCore.Mvc.Localization
@using Ofix.Localization
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<OfixResource> L
@{
    PageLayout.Content.Title = string.Empty;
    PageLayout.Content.BreadCrumb.ShowCurrent = false;
    PageLayout.Content.ShowToolbar = false;
    PageLayout.Content.MenuItemName = OfixMenus.Home;
}

@section styles {
    <abp-style src="/Pages/Index.css" />
}

@section scripts {
    <abp-script src="/Pages/Index.js" />
}

<div class="ofix-home container py-4">
    <p class="ofix-home-intro lead text-center mb-4">@L["Home:Intro"]</p>

    <partial name="Index/Partials/_HomeBrandStrip" model="Model.ViewModel.BrandStrip" />

    <partial name="Index/Partials/_HomeSearchBox" model="Model.ViewModel" />

    <partial name="Index/Partials/_HomeLastSearch" model="Model.ViewModel.IsLoggedIn" />

    <partial name="Index/Partials/_HomeRecentListings" model="Model.ViewModel.RecentListings" />

    <partial name="Index/Partials/_HomeContentRows" />

    <partial name="Index/Partials/_HomeWhyOfix" />
</div>
